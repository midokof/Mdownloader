<Application x:Class="NovaDownload.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NovaDownload.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- index 0 is swapped at runtime by ThemeService -->
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Themes/Shell.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:InverseBooleanConverter x:Key="InverseBool"/>
            <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
