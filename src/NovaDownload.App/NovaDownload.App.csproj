<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only the tray icon needs WinForms; its implicit usings are removed below so that
         System.Windows.Application stays unambiguous across the WPF code. -->
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NovaDownload.App</RootNamespace>
    <AssemblyName>NovaDownload.App</AssemblyName>
    <ApplicationIcon>..\..\assets\novadownload.ico</ApplicationIcon>
    <Product>NovaDownload</Product>
    <AssemblyTitle>NovaDownload</AssemblyTitle>
    <Description>Download manager with verified browser integration</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaDownload.Core\NovaDownload.Core.csproj" />
    <ProjectReference Include="..\NovaDownload.Infrastructure\NovaDownload.Infrastructure.csproj" />
    <ProjectReference Include="..\NovaDownload.DownloadEngine\NovaDownload.DownloadEngine.csproj" />
    <ProjectReference Include="..\NovaDownload.BrowserIntegration\NovaDownload.BrowserIntegration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same icon as the executable, loaded at runtime for the window and the tray. -->
    <Resource Include="..\..\assets\novadownload.ico" Link="Assets\novadownload.ico" />
  </ItemGroup>

</Project>
