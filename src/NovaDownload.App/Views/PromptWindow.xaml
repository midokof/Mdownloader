<Window x:Class="NovaDownload.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NovaDownload.App.Markup"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}">
        <StackPanel Margin="22,18,22,18">
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2Text}"/>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        AutomationProperties.Name="Close" Click="Cancel_Click">
                    <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>

            <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                       Margin="0,16,0,6"/>

            <Border Style="{StaticResource InputFrame}">
                <TextBox x:Name="ValueBox" Style="{StaticResource InputBox}"
                         AutomationProperties.AutomationId="PromptValueBox"
                         AutomationProperties.Name="Name"
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
            </Border>

            <Border Margin="0,10,0,0" CornerRadius="8" Padding="10,8"
                    Background="{DynamicResource ErrorSoftBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource ErrorBrush}"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Btn_Cancel}"
                        MinWidth="100" AutomationProperties.Name="Cancel" Click="Cancel_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr Btn_Ok}"
                        MinWidth="110" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="PromptConfirm"
                        AutomationProperties.Name="OK" Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
