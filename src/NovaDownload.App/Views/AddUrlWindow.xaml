<Window x:Class="NovaDownload.App.Views.AddUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NovaDownload.App.Markup"
        Title="{loc:Tr Dlg_AddUrlTitle}"
        Width="640" Height="470" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}">
                        <Path Data="{StaticResource IconPlus}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{DynamicResource PrimaryBrush}"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr Dlg_AddUrlTitle}" Style="{StaticResource H2Text}"/>
                        <TextBlock Text="{loc:Tr Dlg_AddUrlSubtitle}" Style="{StaticResource CaptionText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="{loc:Tr Tooltip_Close}" AutomationProperties.Name="Close" Click="Cancel_Click">
                    <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>

            <TextBlock Grid.Row="1" Text="{loc:Tr Dlg_UrlsLabel}" Style="{StaticResource CaptionText}"
                       FontWeight="SemiBold" Margin="0,18,0,8"/>

            <Border Grid.Row="2" Style="{StaticResource InputFrame}" Padding="2">
                <TextBox Style="{StaticResource InputBox}"
                         AutomationProperties.AutomationId="AddUrlBox"
                         AutomationProperties.Name="URL"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         MinHeight="150"
                         Text="{Binding Urls, UpdateSourceTrigger=PropertyChanged}"/>
            </Border>

            <!-- error -->
            <Border Grid.Row="3" Margin="0,10,0,0" CornerRadius="8" Padding="10,8"
                    Background="{DynamicResource ErrorSoftBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource ErrorBrush}"/>
            </Border>

            <!-- folder + shortcuts -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{loc:Tr Field_SaveTo}" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource InputFrame}">
                        <TextBox Style="{StaticResource InputBox}"
                                 AutomationProperties.AutomationId="AddUrlFolderBox"
                                 AutomationProperties.Name="Save to"
                                 Text="{Binding DestinationDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,20,0,0"
                        Padding="12,7" Command="{Binding BrowseCommand}"
                        AutomationProperties.Name="Browse folder">
                    <Path Data="{StaticResource IconFolder}" Width="13" Height="13" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}"/>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Padding="12,7"
                            Command="{Binding PasteCommand}"
                            AutomationProperties.Name="Paste">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLink}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="{loc:Tr Btn_Paste}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="8,0,0,0"
                            Command="{Binding BrowseTorrentCommand}"
                            AutomationProperties.Name="Open torrent">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTorrent}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="{loc:Tr Btn_OpenTorrent}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- actions -->
            <Grid Grid.Row="5" Margin="0,18,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Btn_Cancel}"
                        AutomationProperties.Name="Cancel" HorizontalAlignment="Left" MinWidth="110"
                        Click="Cancel_Click"/>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="150"
                        AutomationProperties.AutomationId="AddUrlConfirm"
                        AutomationProperties.Name="Add" Click="Accept_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Width="13" Height="13" Stretch="Uniform"
                              Fill="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{loc:Tr Btn_Add}" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
