<UserControl x:Class="NovaDownload.App.Views.AddDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaDownload.App.ViewModels"
             xmlns:loc="clr-namespace:NovaDownload.App.Markup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AddDownloadViewModel}"
             Background="Transparent">

    <UserControl.InputBindings>
        <KeyBinding Key="Return" Command="{Binding StartDownloadCommand}"/>
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,26,26">
        <Border Style="{StaticResource Card}" Width="720" Padding="26,24"
                HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}">
                        <Path Data="{StaticResource IconLink}" Width="18" Height="18" Stretch="Uniform"
                              Fill="{DynamicResource PrimaryBrush}"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr Add_Title}" Style="{StaticResource H2Text}"/>
                        <TextBlock Text="{loc:Tr Add_Subtitle}"
                                   Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- URL -->
                <TextBlock Text="{loc:Tr Field_Url}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,24,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource InputFrame}">
                        <TextBox x:Name="UrlBox" Style="{StaticResource InputBox}"
                                 AutomationProperties.AutomationId="UrlBox"
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{loc:Tr Btn_Paste}"
                            AutomationProperties.Name="Paste"
                            Command="{Binding PasteCommand}" Margin="8,0,0,0" Padding="16,8"/>
                </Grid>

                <!-- filename -->
                <TextBlock Text="{loc:Tr Field_FileName}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <Border Style="{StaticResource InputFrame}">
                    <TextBox Style="{StaticResource InputBox}"
                             AutomationProperties.AutomationId="FileNameBox"
                             AutomationProperties.Name="File name"
                             Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>
                <TextBlock Text="{loc:Tr Add_FileNameHint}" Style="{StaticResource CaptionText}" Margin="2,6,0,0"/>

                <!-- folder -->
                <TextBlock Text="{loc:Tr Field_SaveTo}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource InputFrame}">
                        <TextBox Style="{StaticResource InputBox}"
                                 AutomationProperties.AutomationId="SaveToBox"
                                 AutomationProperties.Name="Save to"
                                 Text="{Binding DestinationDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="Browse"
                            Command="{Binding BrowseCommand}" Margin="8,0,0,0" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{loc:Tr Btn_Browse}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- error -->
                <Border CornerRadius="9" Padding="12,9" Margin="0,16,0,0"
                        Background="{DynamicResource ErrorSoftBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorBrush}"/>
                </Border>

                <!-- actions -->
                <Grid Margin="0,24,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCheck}" Width="12" Height="12" Stretch="Uniform"
                              Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="{loc:Tr Add_ResumeHint}"
                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                            AutomationProperties.Name="Start download"
                            AutomationProperties.AutomationId="StartDownload"
                            Command="{Binding StartDownloadCommand}" IsEnabled="{Binding CanStart}" MinWidth="150">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:Tr Btn_Start}" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

