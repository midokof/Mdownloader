<UserControl x:Class="NovaDownload.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaDownload.App.ViewModels"
             xmlns:loc="clr-namespace:NovaDownload.App.Markup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DownloadsViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="DownloadRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="14" Padding="16,14"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="8" Padding="10,5" Background="{DynamicResource PrimarySoftBrush}">
                    <TextBlock Text="{Binding ActiveChipText}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                </Border>
                <Border CornerRadius="8" Padding="10,5" Background="{DynamicResource SuccessSoftBrush}" Margin="8,0,0,0">
                    <TextBlock Text="{Binding DoneChipText}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessBrush}"/>
                </Border>
                <Border CornerRadius="8" Padding="10,5" Background="{DynamicResource ErrorSoftBrush}" Margin="8,0,0,0">
                    <TextBlock Text="{Binding FailedChipText}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource ErrorBrush}"/>
                </Border>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Btn_PauseAll}"
                        AutomationProperties.AutomationId="PauseAll"
                        Command="{Binding PauseAllCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Btn_ResumeAll}"
                        AutomationProperties.AutomationId="ResumeAll"
                        Command="{Binding ResumeAllCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Btn_ClearFinished}"
                        AutomationProperties.AutomationId="ClearFinished"
                        Command="{Binding ClearFinishedCommand}"/>
            </StackPanel>
        </Grid>

        <!-- list -->
        <ListBox Grid.Row="1" x:Name="DownloadList"
                 ItemsSource="{Binding View}"
                 ItemContainerStyle="{StaticResource DownloadRow}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Padding="0,0,6,20"
                 MouseDoubleClick="DownloadList_MouseDoubleClick">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- file badge -->
                        <Border Width="42" Height="42" CornerRadius="11" VerticalAlignment="Top"
                                Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=bg}">
                            <TextBlock Text="{Binding Extension}" FontSize="9.5" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                        </Border>

                        <!-- name / folder / progress -->
                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,90,0"
                                           ToolTip="{Binding DetailText}"/>
                                <Border CornerRadius="6" Padding="7,2" HorizontalAlignment="Right"
                                        Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=bg}">
                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding Folder}" Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                       ToolTip="{Binding DestinationPath}"/>

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Style="{StaticResource ThinProgress}" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}" Height="6"
                                             VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercentText}" Margin="12,0,0,0"
                                           FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                <TextBlock Grid.Column="2" Text="{Binding ProgressText}" Style="{StaticResource CaptionText}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- telemetry -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTip="{Binding DetailText}">
                            <TextBlock Text="{Binding MetricPrimary}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding MetricSecondary}" Style="{StaticResource CaptionText}"
                                       Margin="0,3,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <!-- actions -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <Button Style="{StaticResource IconButton}" ToolTip="{loc:Tr Tooltip_Pause}" AutomationProperties.Name="Pause"
                                    Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource IconPause}" Width="11" Height="11" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="{loc:Tr Tooltip_Resume}" AutomationProperties.Name="Resume"
                                    Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource IconPlay}" Width="11" Height="11" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="{loc:Tr Tooltip_OpenFolder}" AutomationProperties.Name="Open folder"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <Path Data="{StaticResource IconFolder}" Width="13" Height="13" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource DangerIconButton}" ToolTip="{loc:Tr Tooltip_Cancel}" AutomationProperties.Name="Cancel"
                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsOngoing, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource IconClose}" Width="11" Height="11" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource DangerIconButton}" ToolTip="{loc:Tr Tooltip_Remove}" AutomationProperties.Name="Remove"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <Path Data="{StaticResource IconTrash}" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- empty state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconDownload}" Width="24" Height="24" Stretch="Uniform"
                      Fill="{DynamicResource TextMutedBrush}"/>
            </Border>
            <TextBlock Text="{loc:Tr Empty_Title}" Style="{StaticResource H2Text}" Margin="0,16,0,4" HorizontalAlignment="Center"/>
            <TextBlock Text="{loc:Tr Empty_Subtitle}"
                       Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>

