<Window x:Class="NovaDownload.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NovaDownload.App.Markup"
        Title="NovaDownload"
        Height="760" Width="1240" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Icon="pack://application:,,,/Assets/novadownload.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddUrlCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Key="F3" Command="{Binding FindNextCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F9" Command="{Binding SpeedLimitCommand}"/>
    </Window.InputBindings>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= title bar ================= -->
            <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource PrimarySoftBrush}">
                        <Path Data="{StaticResource IconDownload}" Width="12" Height="12" Stretch="Uniform"
                              Fill="{DynamicResource PrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="NovaDownload" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowButton}" ToolTip="{loc:Tr Tooltip_Minimize}"
                            AutomationProperties.Name="Minimize" Click="Minimize_Click">
                        <Path Data="{StaticResource IconMinimize}" Width="10" Height="10" Stretch="Uniform"
                              Fill="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource WindowButton}" ToolTip="{loc:Tr Tooltip_Maximize}"
                            AutomationProperties.Name="Maximize" Click="Maximize_Click">
                        <Path x:Name="MaxIcon" Data="{StaticResource IconMaximize}" Width="10" Height="10"
                              Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource CloseWindowButton}" ToolTip="{loc:Tr Tooltip_Close}"
                            AutomationProperties.Name="Close window" Click="Close_Click">
                        <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                              Fill="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= menu bar ================= -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Menu Padding="6,2" AutomationProperties.AutomationId="MainMenu">
                    <MenuItem Header="{loc:Tr Menu_Tasks}">
                        <MenuItem Header="{loc:Tr Menu_AddUrl}" InputGestureText="Ctrl+N"
                                  Command="{Binding AddUrlCommand}"/>
                        <MenuItem Header="{loc:Tr Menu_PasteUrl}" InputGestureText="Ctrl+V"
                                  Command="{Binding PasteUrlCommand}"/>
                        <MenuItem Header="{loc:Tr Menu_OpenTorrent}" Command="{Binding OpenTorrentCommand}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="{loc:Tr Menu_Refresh}" InputGestureText="F5"
                                  Command="{Binding RefreshCommand}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="{loc:Tr Menu_Exit}" InputGestureText="Alt+F4"
                                  Command="{Binding ExitCommand}"/>
                    </MenuItem>

                    <MenuItem Header="{loc:Tr Menu_File}">
                        <MenuItem Header="{loc:Tr Menu_RemoveFiles}" Command="{Binding Downloads.RemoveWithFilesCommand}"/>
                        <MenuItem Header="{loc:Tr Menu_ChooseFiles}" Command="{Binding Downloads.ChooseFilesCommand}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="{loc:Tr Ctx_OpenFile}" Command="{Binding Downloads.OpenFileCommand}"/>
                        <MenuItem Header="{loc:Tr Ctx_OpenFolder}" Command="{Binding Downloads.OpenFolderCommand}"/>
                        <MenuItem Header="{loc:Tr Ctx_CopyUrl}" Command="{Binding Downloads.CopyUrlCommand}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="{loc:Tr Menu_PauseAll}" Command="{Binding Downloads.PauseAllCommand}"/>
                        <MenuItem Header="{loc:Tr Menu_StopAll}" Command="{Binding Downloads.StopAllCommand}"/>
                    </MenuItem>

                    <MenuItem Header="{loc:Tr Menu_Downloads}">
                        <MenuItem Header="{loc:Tr Menu_PauseAll}" Command="{Binding Downloads.PauseAllCommand}"/>
                        <MenuItem Header="{loc:Tr Menu_StopAll}" Command="{Binding Downloads.StopAllCommand}"/>
                        <MenuItem Header="{loc:Tr Menu_ClearFinished}" Command="{Binding Downloads.ClearFinishedCommand}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="{loc:Tr Menu_Find}" InputGestureText="Ctrl+F"
                                  Command="{Binding FocusSearchCommand}"/>
                        <MenuItem Header="{loc:Tr Menu_Next}" InputGestureText="F3"
                                  Command="{Binding FindNextCommand}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="{loc:Tr Menu_Scheduler}" Command="{Binding SchedulerCommand}"/>
                        <MenuItem Header="{loc:Tr Menu_SpeedLimit}" InputGestureText="F9"
                                  Command="{Binding SpeedLimitCommand}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="{loc:Tr Menu_StartQueue}" Command="{Binding Downloads.ResumeAllCommand}"/>
                        <MenuItem Header="{loc:Tr Menu_StopQueue}" Command="{Binding Downloads.PauseAllCommand}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="{loc:Tr Menu_Options}" Command="{Binding OptionsCommand}"/>
                    </MenuItem>

                    <MenuItem Header="{loc:Tr Menu_View}">
                        <MenuItem Header="{loc:Tr Menu_CategoryPane}"
                                  IsChecked="{Binding ShowCategoryPane, Mode=OneWay}"
                                  Command="{Binding ToggleCategoryPaneCommand}"/>
                        <MenuItem Header="{loc:Tr Menu_Toolbar}"
                                  IsChecked="{Binding ShowToolbar, Mode=OneWay}"
                                  Command="{Binding ToggleToolbarCommand}"/>
                        <MenuItem Header="{loc:Tr Menu_StatusBar}"
                                  IsChecked="{Binding ShowStatusBar, Mode=OneWay}"
                                  Command="{Binding ToggleStatusBarCommand}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="{loc:Tr Menu_DarkTheme}"
                                  IsChecked="{Binding IsDark, Mode=OneWay}"
                                  Command="{Binding ToggleThemeCommand}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="{loc:Tr Menu_Language}">
                            <MenuItem Header="{loc:Tr Menu_French}"
                                      IsChecked="{Binding IsFrench, Mode=OneWay}"
                                      Command="{Binding SetFrenchCommand}"/>
                            <MenuItem Header="{loc:Tr Menu_English}"
                                      IsChecked="{Binding IsEnglish, Mode=OneWay}"
                                      Command="{Binding SetEnglishCommand}"/>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="{loc:Tr Menu_Help}">
                        <MenuItem Header="{loc:Tr Menu_HelpContents}" Command="{Binding HelpCommand}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Header="{loc:Tr Menu_About}" Command="{Binding AboutCommand}"/>
                    </MenuItem>
                </Menu>
            </Border>

            <!-- ================= toolbar ================= -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1"
                    Padding="8,5" Visibility="{Binding ShowToolbar, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding AddUrlCommand}"
                            AutomationProperties.AutomationId="ToolAddUrl"
                            AutomationProperties.Name="Add URL">
                        <StackPanel>
                            <Path Data="{StaticResource IconPlus}" Width="17" Height="17" Stretch="Uniform"
                                  Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Tool_AddUrl}" FontSize="10.5" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource ToolbarSeparator}"/>

                    <Button Style="{StaticResource ToolButton}" Command="{Binding Downloads.ResumeCommand}"
                            IsEnabled="{Binding Downloads.HasSelection}"
                            AutomationProperties.AutomationId="ToolResume"
                            AutomationProperties.Name="Resume">
                        <StackPanel>
                            <Path Data="{StaticResource IconPlay}" Width="17" Height="17" Stretch="Uniform"
                                  Fill="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Tool_Resume}" FontSize="10.5" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolButton}" Command="{Binding Downloads.PauseCommand}"
                            IsEnabled="{Binding Downloads.HasSelection}"
                            AutomationProperties.AutomationId="ToolPause"
                            AutomationProperties.Name="Stop">
                        <StackPanel>
                            <Path Data="{StaticResource IconPause}" Width="17" Height="17" Stretch="Uniform"
                                  Fill="{DynamicResource WarningBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Tool_Stop}" FontSize="10.5" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolButton}" Command="{Binding Downloads.StopAllCommand}"
                            AutomationProperties.AutomationId="ToolStopAll"
                            AutomationProperties.Name="Stop all">
                        <StackPanel>
                            <Path Data="{StaticResource IconStopAll}" Width="17" Height="17" Stretch="Uniform"
                                  Fill="{DynamicResource ErrorBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Tool_StopAll}" FontSize="10.5" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource ToolbarSeparator}"/>

                    <Button Style="{StaticResource ToolButton}" Command="{Binding Downloads.RemoveCommand}"
                            IsEnabled="{Binding Downloads.HasSelection}"
                            AutomationProperties.AutomationId="ToolRemove"
                            AutomationProperties.Name="Remove">
                        <StackPanel>
                            <Path Data="{StaticResource IconTrash}" Width="17" Height="17" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Tool_Remove}" FontSize="10.5" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolButton}" Command="{Binding Downloads.ClearFinishedCommand}"
                            AutomationProperties.AutomationId="ToolClearFinished"
                            AutomationProperties.Name="Remove completed">
                        <StackPanel>
                            <Path Data="{StaticResource IconClearSweep}" Width="17" Height="17" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Tool_ClearFinished}" FontSize="10.5" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource ToolbarSeparator}"/>

                    <Button Style="{StaticResource ToolButton}" Command="{Binding OptionsCommand}"
                            AutomationProperties.AutomationId="ToolOptions"
                            AutomationProperties.Name="Options">
                        <StackPanel>
                            <Path Data="{StaticResource IconSettings}" Width="17" Height="17" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Tool_Options}" FontSize="10.5" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolButton}" Command="{Binding SchedulerCommand}"
                            AutomationProperties.AutomationId="ToolScheduler"
                            AutomationProperties.Name="Scheduler">
                        <StackPanel>
                            <Path Data="{StaticResource IconCalendar}" Width="17" Height="17" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Tool_Scheduler}" FontSize="10.5" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource ToolbarSeparator}"/>

                    <Button Style="{StaticResource ToolButton}" Command="{Binding Downloads.ResumeAllCommand}"
                            AutomationProperties.AutomationId="ToolStartQueue"
                            AutomationProperties.Name="Start queue">
                        <StackPanel>
                            <Path Data="{StaticResource IconBolt}" Width="17" Height="17" Stretch="Uniform"
                                  Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Tool_StartQueue}" FontSize="10.5" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolButton}" Command="{Binding Downloads.PauseAllCommand}"
                            AutomationProperties.AutomationId="ToolStopQueue"
                            AutomationProperties.Name="Stop queue">
                        <StackPanel>
                            <Path Data="{StaticResource IconStop}" Width="17" Height="17" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Tool_StopQueue}" FontSize="10.5" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ================= body ================= -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- category pane -->
                <Border Grid.Column="0" Width="232" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                        Visibility="{Binding ShowCategoryPane, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="14,12,10,6">
                            <TextBlock Text="{loc:Tr Cat_Title}" Style="{StaticResource CaptionText}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                    HorizontalAlignment="Right"
                                    ToolTip="{loc:Tr Tooltip_HidePane}"
                                    AutomationProperties.Name="Hide categories"
                                    Command="{Binding ToggleCategoryPaneCommand}">
                                <Path Data="{StaticResource IconClose}" Width="8" Height="8" Stretch="Uniform"
                                      Fill="{DynamicResource TextMutedBrush}"/>
                            </Button>
                        </Grid>

                        <TreeView x:Name="CategoryTree" Grid.Row="1" Margin="8,0,8,8"
                                  Background="Transparent" BorderThickness="0"
                                  AutomationProperties.AutomationId="CategoryTree"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItemChanged="CategoryTree_SelectedItemChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <!-- The header is a template, so the node needs an explicit name for
                                         screen readers and for the UI-automation harness. -->
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,1"
                                                AutomationProperties.Name="{Binding Label}">
                                        <Path Data="{Binding Icon}" Width="13" Height="13" Stretch="Uniform"
                                              Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- list -->
                <Grid Grid.Column="1" Margin="14,12,14,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Padding="0" CornerRadius="12">
                        <Grid>
                            <ListView x:Name="DownloadsList" Style="{StaticResource ShellList}"
                                      ItemsSource="{Binding Downloads.View}"
                                      AlternationCount="2"
                                      AutomationProperties.AutomationId="DownloadsList"
                                      SelectionChanged="DownloadsList_SelectionChanged"
                                      PreviewMouseRightButtonDown="DownloadsList_PreviewMouseRightButtonDown">
                                <ListView.InputBindings>
                                    <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteUrlCommand}"/>
                                    <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}"/>
                                    <KeyBinding Key="Delete" Command="{Binding Downloads.RemoveCommand}"/>
                                </ListView.InputBindings>

                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Tr Ctx_DownloadNow}"
                                                  Command="{Binding Downloads.ResumeCommand}"/>
                                        <MenuItem Header="{loc:Tr Ctx_Stop}"
                                                  Command="{Binding Downloads.PauseCommand}"/>
                                        <MenuItem Header="{loc:Tr Ctx_Redownload}"
                                                  Command="{Binding Downloads.RestartCommand}"/>
                                        <MenuItem Header="{loc:Tr Ctx_Remove}"
                                                  Command="{Binding Downloads.RemoveCommand}"/>
                                        <Separator Style="{StaticResource MenuSeparator}"/>
                                        <MenuItem Header="{loc:Tr Ctx_OpenFile}"
                                                  Command="{Binding Downloads.OpenFileCommand}"/>
                                        <MenuItem Header="{loc:Tr Ctx_OpenFolder}"
                                                  Command="{Binding Downloads.OpenFolderCommand}"/>
                                        <MenuItem Header="{loc:Tr Ctx_CopyUrl}"
                                                  Command="{Binding Downloads.CopyUrlCommand}"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>

                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource ShellColumnHeader}">
                                        <GridViewColumn Header="{loc:Tr Col_Name}" Width="250">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="8,6,8,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="24" Height="24" CornerRadius="7"
                                                                    Background="{DynamicResource PrimarySoftBrush}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Initial}" FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding FileName}" Margin="9,0,0,0"
                                                                       FontWeight="SemiBold" FontSize="12.5"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                                        </StackPanel>
                                                        <ProgressBar Style="{StaticResource ThinProgress}" Height="3"
                                                                     Margin="0,5,0,0" Maximum="100"
                                                                     Value="{Binding ProgressPercent, Mode=OneWay}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="{loc:Tr Col_Queue}" Width="34"
                                                        DisplayMemberBinding="{Binding QueueText}"/>
                                        <GridViewColumn Header="{loc:Tr Col_Type}" Width="90"
                                                        DisplayMemberBinding="{Binding TypeText}"/>
                                        <GridViewColumn Header="{loc:Tr Col_Size}" Width="76"
                                                        DisplayMemberBinding="{Binding SizeText}"/>
                                        <GridViewColumn Header="{loc:Tr Col_Status}" Width="88"
                                                        DisplayMemberBinding="{Binding StatusText}"/>
                                        <GridViewColumn Header="{loc:Tr Col_Remaining}" Width="70"
                                                        DisplayMemberBinding="{Binding RemainingText}"/>
                                        <GridViewColumn Header="{loc:Tr Col_Rate}" Width="82"
                                                        DisplayMemberBinding="{Binding RateText}"/>
                                        <GridViewColumn Header="{loc:Tr Col_LastTried}" Width="112"
                                                        DisplayMemberBinding="{Binding LastTriedText}"/>
                                        <GridViewColumn Header="{loc:Tr Col_Description}" Width="128"
                                                        DisplayMemberBinding="{Binding Description}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!-- empty state -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding Downloads.IsEmpty, Converter={StaticResource BoolToVis}}">
                                <Border Width="52" Height="52" CornerRadius="15"
                                        Background="{DynamicResource SurfaceAltBrush}" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconDownload}" Width="22" Height="22" Stretch="Uniform"
                                          Fill="{DynamicResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock Text="{loc:Tr List_EmptyTitle}" Style="{StaticResource H2Text}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock Text="{loc:Tr List_EmptySubtitle}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= status bar ================= -->
            <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="12,5" Visibility="{Binding ShowStatusBar, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Downloads.CountsText}"
                               Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="StatusCounts"/>

                    <Border Grid.Column="1" Style="{StaticResource ToolbarSeparator}" Margin="10,2"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Downloads.GlobalSpeedText}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   AutomationProperties.AutomationId="StatusSpeed"/>
                        <ProgressBar Style="{StaticResource ThinProgress}" Width="130" Margin="12,0,0,0"
                                     Height="5" Maximum="100"
                                     Value="{Binding Downloads.OverallProgress, Mode=OneWay}"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="StatusProgress"/>
                        <TextBlock Text="{Binding Downloads.OverallPercentText}"
                                   Style="{StaticResource CaptionText}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionText}" Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="4" Text="{Binding Downloads.QueueHintText}"
                               Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Border Grid.Column="5" Width="220" Height="26" CornerRadius="7"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconFind}" Width="11" Height="11" Stretch="Uniform"
                                  Fill="{DynamicResource TextMutedBrush}" Margin="9,0,0,0"
                                  VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource InputBox}"
                                     Padding="7,0" FontSize="12"
                                     AutomationProperties.AutomationId="SearchBox"
                                     AutomationProperties.Name="Search"
                                     Text="{Binding Downloads.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1" Text="{loc:Tr Search_Placeholder}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding Downloads.HasSearchText, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
