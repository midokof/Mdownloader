<Window x:Class="NovaDownload.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NovaDownload.App.Views"
        xmlns:vm="clr-namespace:NovaDownload.App.ViewModels"
        xmlns:loc="clr-namespace:NovaDownload.App.Markup"
        Title="NovaDownload"
        Height="820" Width="1280" MinHeight="640" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
            <views:DownloadsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddDownloadViewModel}">
            <views:AddDownloadView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="246"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================ SIDEBAR ============================ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,20,26"
                                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource PrimaryGradientBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#3B82F6"/>
                            </Border.Effect>
                            <TextBlock Text="N" Foreground="White" FontSize="19" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NovaDownload" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Tr App_Tagline}" Style="{StaticResource CaptionText}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- navigation -->
                    <StackPanel Grid.Row="1" Margin="14,0">
                        <TextBlock Text="{loc:Tr Section_Workspace}" Style="{StaticResource CaptionText}"
                                   Margin="12,0,0,8" FontWeight="SemiBold"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="{loc:Tr Nav_Dashboard}"
                                     AutomationProperties.AutomationId="NavDashboard"
                                     Tag="{StaticResource IconDashboard}" CommandParameter="Dashboard"
                                     IsChecked="{Binding IsDashboard, Mode=OneWay}"
                                     Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="{loc:Tr Nav_Downloads}"
                                     AutomationProperties.AutomationId="NavDownloads"
                                     Tag="{StaticResource IconDownload}" CommandParameter="Downloads"
                                     IsChecked="{Binding IsDownloads, Mode=OneWay}"
                                     Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="{loc:Tr Nav_NewDownload}"
                                     AutomationProperties.AutomationId="NavAddDownload"
                                     Tag="{StaticResource IconPlus}" CommandParameter="AddDownload"
                                     IsChecked="{Binding IsAddDownload, Mode=OneWay}"
                                     Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="{loc:Tr Nav_History}"
                                     AutomationProperties.AutomationId="NavHistory"
                                     Tag="{StaticResource IconHistory}" CommandParameter="History"
                                     IsChecked="{Binding IsHistory, Mode=OneWay}"
                                     Checked="Nav_Checked"/>

                        <TextBlock Text="{loc:Tr Section_System}" Style="{StaticResource CaptionText}"
                                   Margin="12,22,0,8" FontWeight="SemiBold"/>
                        <RadioButton Style="{StaticResource NavButton}" Content="{loc:Tr Nav_Settings}"
                                     AutomationProperties.AutomationId="NavSettings"
                                     Tag="{StaticResource IconSettings}" CommandParameter="Settings"
                                     IsChecked="{Binding IsSettings, Mode=OneWay}"
                                     Checked="Nav_Checked"/>
                    </StackPanel>

                    <!-- live speed footer -->
                    <Border Grid.Row="2" Margin="16,0,16,18" CornerRadius="12" Padding="14,12"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{loc:Tr Sidebar_TotalSpeed}" Style="{StaticResource CaptionText}"/>
                                <Path Data="{StaticResource IconBolt}" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="{Binding Dashboard.TotalSpeedText}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SidebarSummary}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================ MAIN ============================ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- header -->
                <Border Grid.Row="0" Background="{DynamicResource BgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="26,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1Text}"/>
                            <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- search -->
                        <Grid Grid.Column="1" Width="280" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Height="38"/>
                            <Path Data="{StaticResource IconSearch}" Width="15" Height="15" Stretch="Uniform"
                                  Fill="{DynamicResource TextMutedBrush}" Margin="12,0,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource PrimaryBrush}"
                                     FontSize="13" Padding="36,0,10,0" Height="38"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Search_Placeholder}" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                       Margin="38,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- theme + window controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}"
                                    ToolTip="{loc:Tr Tooltip_ToggleTheme}" Width="36" Height="36">
                                <TextBlock Text="{Binding ThemeLabel}" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                            <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="8,0"/>
                            <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="{loc:Tr Tooltip_Minimize}">
                                <Path Data="{StaticResource IconMinimize}" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="{loc:Tr Tooltip_Maximize}">
                                <Path x:Name="MaxIcon" Data="{StaticResource IconMaximize}" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="Close_Click" ToolTip="{loc:Tr Tooltip_Close}">
                                <Path Data="{StaticResource IconClose}" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
