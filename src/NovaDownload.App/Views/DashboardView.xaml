<UserControl x:Class="NovaDownload.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaDownload.App.ViewModels"
             xmlns:loc="clr-namespace:NovaDownload.App.Markup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource MetricText}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,26,26">
        <StackPanel>

            <!-- ============================ metrics ============================ -->
            <UniformGrid Columns="4" Margin="0,0,0,18">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <Grid>
                            <Border Style="{StaticResource IconTile}" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Left">
                                <Path Data="{StaticResource IconDownload}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{DynamicResource PrimaryBrush}"/>
                            </Border>
                            <TextBlock Text="{loc:Tr Metric_Active}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding ActiveDownloads}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="{loc:Tr Metric_ActiveSub}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <Grid>
                            <Border Style="{StaticResource IconTile}" Background="{DynamicResource SuccessSoftBrush}" HorizontalAlignment="Left">
                                <Path Data="{StaticResource IconCheck}" Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource SuccessBrush}"/>
                            </Border>
                            <TextBlock Text="{loc:Tr Metric_Completed}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding CompletedDownloads}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="{loc:Tr Metric_CompletedSub}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <Grid>
                            <Border Style="{StaticResource IconTile}" Background="{DynamicResource ErrorSoftBrush}" HorizontalAlignment="Left">
                                <Path Data="{StaticResource IconAlert}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{DynamicResource ErrorBrush}"/>
                            </Border>
                            <TextBlock Text="{loc:Tr Metric_Failed}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding FailedDownloads}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="{loc:Tr Metric_FailedSub}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}" Margin="0">
                    <StackPanel>
                        <Grid>
                            <Border Style="{StaticResource IconTile}" Background="{DynamicResource SurfaceAltBrush}" HorizontalAlignment="Left">
                                <Path Data="{StaticResource IconBolt}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="{loc:Tr Metric_Throughput}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding TotalSpeedText}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="{loc:Tr Metric_ThroughputSub}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============================ body ============================ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="336"/>
                </Grid.ColumnDefinitions>

                <!-- left -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Dash_ActiveTitle}" Style="{StaticResource H2Text}"/>
                                    <TextBlock Text="{loc:Tr Dash_ActiveSubtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalSpeedText}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding OverallProgressText}" Style="{StaticResource CaptionText}"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <ProgressBar Style="{StaticResource ThinProgress}" Height="8" Maximum="100"
                                         Value="{Binding OverallProgress, Mode=OneWay}" Margin="0,0,0,16"/>

                            <ItemsControl ItemsSource="{Binding ActiveItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10"
                                                Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding Extension}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Style="{StaticResource ThinProgress}" Height="5" Maximum="100"
                                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                 VerticalAlignment="Center" Margin="0,7,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="118">
                                                    <Border CornerRadius="6" Padding="7,3" HorizontalAlignment="Right"
                                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=bg}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                                    </Border>
                                                    <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Right" Margin="0,5,0,0">
                                                        <Run Text="{Binding SpeedText, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding EtaText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{loc:Tr Dash_NoActive}"
                                       Margin="2,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActive}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Dash_RecentTitle}" Style="{StaticResource H2Text}"/>
                            <TextBlock Text="{loc:Tr Dash_RecentSubtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,12"/>

                            <ItemsControl ItemsSource="{Binding RecentItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" FontSize="12.5"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center" Margin="12,0"/>
                                            <Border Grid.Column="2" CornerRadius="6" Padding="7,3" VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=bg}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{loc:Tr Dash_NoRecent}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- right -->
                <StackPanel Grid.Column="1">

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Dash_QuickActions}" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewDownloadCommand}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Stretch="Uniform" Fill="White"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:Tr Nav_NewDownload}" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconFolder}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:Tr Dash_OpenFolder}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Dash_Destination}" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding FreeSpaceText}" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{loc:Tr Dash_FreeOnDrive}" Style="{StaticResource CaptionText}" Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,8">
                                <TextBlock Text="{Binding DownloadFolder}" Style="{StaticResource CaptionText}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DownloadFolder}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Dash_Session}" Style="{StaticResource H2Text}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{loc:Tr Dash_Tracked}" Style="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding TotalDownloads}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{loc:Tr Dash_Paused}" Style="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding PausedDownloads}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="{loc:Tr Dash_Overall}" Style="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding OverallPercentText}" HorizontalAlignment="Right"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
