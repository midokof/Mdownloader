<Window x:Class="NovaDownload.App.Views.SpeedLimitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NovaDownload.App.Markup"
        Title="{loc:Tr Speed_Title}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}">
        <StackPanel Margin="22,18,22,18">
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource PrimarySoftBrush}">
                        <Path Data="{StaticResource IconSpeed}" Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource PrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="{loc:Tr Speed_Title}" Style="{StaticResource H2Text}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        AutomationProperties.Name="Close" Click="Cancel_Click">
                    <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>

            <TextBlock Text="{loc:Tr Speed_Label}" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                       Margin="0,18,0,6"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource InputFrame}">
                    <TextBox Style="{StaticResource InputBox}"
                             AutomationProperties.AutomationId="SpeedLimitBox"
                             AutomationProperties.Name="Limit"
                             IsEnabled="{Binding Unlimited, Converter={StaticResource InverseBool}}"
                             Text="{Binding Kib, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="KiB/s" VerticalAlignment="Center" Margin="10,0,0,0"
                           Style="{StaticResource CaptionText}"/>
            </Grid>

            <CheckBox Style="{StaticResource ToggleCheck}" IsChecked="{Binding Unlimited}"
                      Content="{loc:Tr Speed_Unlimited}" Margin="0,12,0,0"
                      AutomationProperties.Name="Unlimited"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock Text="{Binding CurrentText}" Style="{StaticResource CaptionText}" Margin="0,12,0,0"/>
            <TextBlock Text="{loc:Tr Speed_Hint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                       Margin="0,6,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Btn_Cancel}"
                        MinWidth="100" AutomationProperties.Name="Cancel" Click="Cancel_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr Btn_Ok}"
                        MinWidth="110" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="SpeedLimitConfirm"
                        AutomationProperties.Name="OK" Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
