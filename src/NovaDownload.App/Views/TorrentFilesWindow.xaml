<Window x:Class="NovaDownload.App.Views.TorrentFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NovaDownload.App.ViewModels"
        xmlns:loc="clr-namespace:NovaDownload.App.Markup"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TorrentSelectionViewModel}"
        Title="{loc:Tr Torrent_FilesTitle}"
        Width="660" Height="600" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}">
        <Grid Margin="22,20,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource PrimarySoftBrush}">
                        <Path Data="{StaticResource IconFileList}" Width="17" Height="17" Stretch="Uniform"
                              Fill="{DynamicResource PrimaryBrush}"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr Torrent_FilesTitle}" Style="{StaticResource H2Text}"/>
                        <TextBlock Text="{Binding TorrentName}" Style="{StaticResource CaptionText}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="480" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="{loc:Tr Tooltip_Close}" AutomationProperties.Name="Close"
                        Click="Cancel_Click">
                    <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>

            <!-- select all / none -->
            <Grid Grid.Row="1" Margin="0,18,0,10">
                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Torrent_SelectAll}"
                            AutomationProperties.Name="Select all" Padding="12,6"
                            Command="{Binding SelectAllCommand}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Torrent_SelectNone}"
                            AutomationProperties.Name="Select none" Padding="12,6" Margin="8,0,0,0"
                            Command="{Binding SelectNoneCommand}"/>
                </StackPanel>
            </Grid>

            <!-- files -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,6,6,6">
                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9" Padding="10,9" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource ToggleCheck}" IsChecked="{Binding IsSelected}"
                                                  AutomationProperties.Name="{Binding Name}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="430"/>
                                                <TextBlock Text="{Binding RelativePath}" Style="{StaticResource CaptionText}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="430"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- destination: only while the transfer has not started yet -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0"
                        Visibility="{Binding ShowDestination, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:Tr Field_SaveTo}" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource InputFrame}">
                        <TextBox Style="{StaticResource InputBox}"
                                 AutomationProperties.AutomationId="TorrentFolderBox"
                                 AutomationProperties.Name="Save to"
                                 Text="{Binding DestinationDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="Browse" Padding="14,8" Margin="8,0,0,0"
                            Command="{Binding BrowseCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{loc:Tr Btn_Browse}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- actions -->
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Btn_Cancel}"
                        AutomationProperties.Name="Cancel" HorizontalAlignment="Left" MinWidth="110"
                        Click="Cancel_Click"/>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="150"
                        AutomationProperties.AutomationId="TorrentConfirm"
                        AutomationProperties.Name="Confirm selection"
                        IsEnabled="{Binding CanConfirm}" Click="Confirm_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Width="13" Height="13" Stretch="Uniform"
                              Fill="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{loc:Tr Torrent_Confirm}" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
