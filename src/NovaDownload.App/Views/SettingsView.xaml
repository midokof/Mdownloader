<UserControl x:Class="NovaDownload.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NovaDownload.App.ViewModels"
             xmlns:loc="clr-namespace:NovaDownload.App.Markup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,26,26">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <!-- destination -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Set_DownloadsTitle}" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="{loc:Tr Set_DownloadsSubtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,16"/>

                    <TextBlock Text="{loc:Tr Field_DefaultFolder}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource InputFrame}">
                            <TextBox Style="{StaticResource InputBox}"
                                     AutomationProperties.Name="Default folder"
                                     Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{loc:Tr Btn_Browse}"
                                AutomationProperties.Name="Browse"
                                Command="{Binding BrowseCommand}" Margin="8,0,0,0" Padding="14,8"/>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{loc:Tr Btn_Open}"
                                AutomationProperties.Name="Open"
                                Command="{Binding OpenDownloadsFolderCommand}" Margin="8,0,0,0" Padding="14,8"/>
                    </Grid>

                    <CheckBox Style="{StaticResource ToggleCheck}" Content="{loc:Tr Set_Notify}"
                              IsChecked="{Binding NotifyOnComplete}" Margin="0,18,0,0"/>
                    <CheckBox Style="{StaticResource ToggleCheck}" Content="{loc:Tr Set_MinimizeToTray}"
                              IsChecked="{Binding MinimizeToTray}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- performance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Set_PerfTitle}" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="{loc:Tr Set_PerfSubtitle}"
                               Style="{StaticResource CaptionText}" Margin="0,2,0,16"/>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Set_Concurrency}" Style="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{loc:Tr Set_ConcurrencyHint}"
                                       Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Width="220" Style="{StaticResource PreciseSlider}" Minimum="1" Maximum="10" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Value="{Binding MaxConcurrentDownloads}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="7" Padding="10,4"
                                    Margin="12,0,0,0" MinWidth="34">
                                <TextBlock Text="{Binding MaxConcurrentDownloads}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- browser integration -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Set_BrowserTitle}" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="{loc:Tr Set_BrowserSubtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,16"/>

                    <CheckBox Style="{StaticResource ToggleCheck}" Content="{loc:Tr Set_BrowserEnable}"
                              AutomationProperties.AutomationId="BrowserIntegrationToggle"
                              AutomationProperties.Name="Enable browser integration"
                              IsChecked="{Binding EnableBrowserIntegration}" Margin="0,0,0,12"/>
                    <CheckBox Style="{StaticResource ToggleCheck}" Content="{loc:Tr Set_BrowserActivate}"
                              AutomationProperties.AutomationId="BrowserActivateToggle"
                              AutomationProperties.Name="Activate on browser download"
                              IsChecked="{Binding ActivateOnBrowserDownload}"/>

                    <TextBlock Text="{loc:Tr Set_BrowserStatusLabel}" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="0,18,0,6"/>
                    <Grid>
                        <StackPanel Margin="0,0,140,0">
                            <TextBlock Text="{Binding BrowserStatusText}" Style="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="BrowserStatusText"/>
                            <TextBlock Text="{Binding BrowserIdsText}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Btn_RegisterBrowser}"
                                AutomationProperties.AutomationId="RegisterBrowserIntegration"
                                AutomationProperties.Name="Register browser integration"
                                Command="{Binding RegisterBrowserIntegrationCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8"/>
                    </Grid>
                    <TextBlock Text="{Binding BrowserMessage}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="0,10,0,0"
                               AutomationProperties.AutomationId="BrowserMessage"/>
                </StackPanel>
            </Border>

            <!-- appearance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Set_AppearanceTitle}" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="{loc:Tr Set_AppearanceSubtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Theme_Light}" Padding="26,8"
                                AutomationProperties.AutomationId="ThemeLight"
                                Command="{Binding SetLightCommand}"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Theme_Dark}" Padding="26,8"
                                AutomationProperties.AutomationId="ThemeDark"
                                Command="{Binding SetDarkCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- language -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Set_LanguageTitle}" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="{loc:Tr Set_LanguageSubtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Language"
                                     Content="{loc:Tr Lang_System}"
                                     AutomationProperties.AutomationId="LanguageSystem"
                                     IsChecked="{Binding UseSystemLanguage, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Language"
                                     Content="{loc:Tr Lang_English}"
                                     AutomationProperties.AutomationId="LanguageEnglish"
                                     IsChecked="{Binding UseEnglish, Mode=TwoWay}" Margin="8,0,0,0"/>
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Language"
                                     Content="{loc:Tr Lang_French}"
                                     AutomationProperties.AutomationId="LanguageFrench"
                                     IsChecked="{Binding UseFrench, Mode=TwoWay}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- about -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Set_AboutTitle}" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="{loc:Tr Set_AboutVersion}" Style="{StaticResource CaptionText}" Margin="0,2,0,12"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{loc:Tr Set_AboutBody}"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,4,0,8">
                <TextBlock Text="{Binding SavedMessage}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr Btn_Save}"
                        AutomationProperties.AutomationId="SaveSettings"
                        Command="{Binding SaveCommand}" HorizontalAlignment="Right" MinWidth="150"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
